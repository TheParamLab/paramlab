    "@paramlab/api": "workspace:*",
    "@paramlab/auth": "workspace:*",
    "@paramlab/config": "workspace:*",
    "@paramlab/db": "workspace:*",
    "@paramlab/jobs": "workspace:*",
    "@paramlab/ui": "workspace:*",
