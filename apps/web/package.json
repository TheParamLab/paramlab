{
  "name": "@acme/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --env-file=../../.env run next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "bun --env-file=../../.env run next dev --port 3001",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "start": "bun --env-file=../../.env run next start --port 3001",
    "test": "bun test",
    "typecheck": "bun --env-file=../../.env run next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@acme/ui": "workspace:*",
    "@t3-oss/env-nextjs": "0.13.11",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
