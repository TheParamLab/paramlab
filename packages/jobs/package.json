{
  "name": "@paramlab/jobs",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./src/workflows/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "worker": "bun --env-file=../../.env --watch run src/worker.ts",
    "start": "bun run src/worker.ts",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.47.4",
    "@paramlab/config": "workspace:*",
    "@paramlab/emails": "workspace:*"
  },
  "devDependencies": {
    "@paramlab/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
