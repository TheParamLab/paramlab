# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.
#
# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default matches the local Postgres from `docker-compose.yml`.
# For Neon, use the `*.neon.tech` connection string (the HTTP driver is selected
# automatically). For Supabase/self-hosted, the standard `node-postgres` driver
# is used. Override the driver explicitly with DB_DRIVER if needed.
POSTGRES_URL="postgres://postgres:password@localhost:5432/acme"

# Force a specific driver: "node" (node-postgres/TCP) or "neon-http".
# Leave empty to auto-detect from POSTGRES_URL.
# DB_DRIVER=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public site URL (paramlab.ru): used for auth baseURL, emails and metadata.
# The personal account lives on the same domain under /cabinet.
APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME="Acme Inc."
NEXT_PUBLIC_APP_SHORT_NAME="Acme"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: point the web client at a standalone API server.
# Leave empty to use the built-in Next.js route handler at /api/orpc.
# NEXT_PUBLIC_API_URL=http://localhost:7000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 32
# Leave empty here so a weak default is never shipped by accident.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=

# Bootstrap admins (comma-separated): these accounts get the "admin" role on
# sign-up/sign-in. Further admins are assigned via authClient.admin.setRole.
# ADMIN_EMAILS=admin@example.com,ops@example.com

# -----------------------------------------------------------------------------
# Email (local sandbox via inbucket from docker-compose)
# -----------------------------------------------------------------------------
EMAIL_SANDBOX_ENABLED=true
EMAIL_SANDBOX_HOST=localhost

# Primary provider: Yandex Cloud Postbox (AWS-SES-compatible API). Static
# access keys of a service account with the `postbox.sender` role, same
# catalog as the Postbox address. Fallback: Resend.
# YANDEX_POSTBOX_ACCESS_KEY_ID=
# YANDEX_POSTBOX_SECRET_ACCESS_KEY=
# YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
# YANDEX_POSTBOX_REGION=ru-central1
# Required for Postbox: a sender on the verified domain in the same folder as
# the service account. Without it, Postbox answers "404 identity not found".
# EMAIL_FROM="ParamLab <noreply@paramlab.ru>"
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Storage (Yandex Object Storage, S3-compatible)
# -----------------------------------------------------------------------------
# Static access key of a service account with the `storage.editor` role:
# Yandex Cloud console → IAM → Service accounts → Static keys.
# @see https://yandex.cloud/en/docs/storage/s3/s3-api-quickstart
# YANDEX_STORAGE_ACCESS_KEY_ID=
# YANDEX_STORAGE_SECRET_ACCESS_KEY=
# YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
# YANDEX_STORAGE_REGION=ru-central1
# YANDEX_STORAGE_BUCKET=paramlab-files
# CORS: браузер кладет файлы прямо в бакет (presigned PUT с заголовком
# Content-Type) — добавь в бакет правило CORS для origin'ов приложения
# (localhost + прод) с методом PUT (консоль → бакет → CORS).

# -----------------------------------------------------------------------------
# Hatchet (background jobs, durable workflows, DAG orchestration)
# @see https://docs.hatchet.run
# -----------------------------------------------------------------------------
# JWT token from https://cloud.onhatchet.run → Settings → API Tokens
# (or your self-hosted Hatchet instance). Leave empty to run background work
# (e.g. emails) inline in the app; set it and run `bun jobs:dev` for the worker.
HATCHET_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=debug
# OTLP collector for traces (Next.js + oRPC spans; HTTP/protobuf), e.g. a local
# Jaeger/Grafana Alloy at http://localhost:4318. Log lines carry trace_id.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Payments (YooKassa)
# -----------------------------------------------------------------------------
# shopId and secret key from the YooKassa merchant cabinet. Server-only.
# Webhook URL for notifications: /api/payments/yookassa
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# -----------------------------------------------------------------------------
# Ozon Delivery API for business
# -----------------------------------------------------------------------------
# Private app credentials: Ozon Delivery cabinet → Settings → Private apps.
# Required scopes: delivery-api.delivery, delivery-api.delivery-point,
# delivery-api.order, delivery-api.posting, delivery-api.return.
# OZON_DELIVERY_CLIENT_ID=
# OZON_DELIVERY_CLIENT_SECRET=
